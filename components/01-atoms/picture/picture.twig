<picture>
  {% if srcDesktop %}
    <source media="all and (min-width: 1024px)" srcset="{{ srcDesktop }}">
  {% endif %}
  {% if srcTablet %}
    <source media="all and (min-width: 768px)" srcset="{{ srcTablet }}">
  {% endif %}
  {% if src %}
    <img src="{{ src }}" alt="{{ alt }}">
  {% endif %}
</picture>
