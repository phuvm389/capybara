{% if image is not empty %}
  <span class="block-example__image">{{ image }}</span>
{% endif %}
<span class="block-example__content">
  {% if counter is not empty %}
    <span class="block-example__counter js-block-example__counter">{{ counter }}</span>
  {% endif %}
  {% if character is not empty %}
    <span class="block-example__character">{{ character }}</span>
  {% endif %}
</span>
{% if name is not empty %}
  <span class="block-example__name">{{ name }}</span>
{% endif %}
