<div class="three-group-item">
  <div class="three-group-item__image">{{ image }}</div>
  <div class="three-group-item__content">
    {% if title is not empty %}
      <h3 class="three-group-item__title">{{ title }}</h3>
    {% endif %}
    {% if body is not empty %}
      <div class="three-group-item__body">{{ body }}</div>
    {% endif %}
    {% if link is not empty %}
      <div class="three-group-item__link">{{ link }}</div>
    {% endif %}
    {% if tags is not empty %}
      <div class="three-group-item__tags">{{ tags }}</div>
    {% endif %}
  </div>
</div>