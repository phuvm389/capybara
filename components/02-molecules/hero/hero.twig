<div class="hero {{ variants }} {{ sectionSpace }}">
  <div class="container">
    {% if title is not empty %}
      <h1 class="hero__title">{{ title }}</h1>
    {% endif %}
    {% if body is not empty %}
      <div class="hero__body">{{ body }}</div>
    {% endif %}
    {% if links is not empty %}
      <div class="hero__links">{{ links }}</div>
    {% endif %}
  </div>
</div>