  <div class="container {{ sectionSpace }}">
    <div class="text-image__grid">
      <div class="text-image__text">
        {% if title is not empty %}
          <h2 class="text-image__title">{{ title }}</h2>
        {% endif %}
        {% if body is not empty %}
          <div class="text-image__body">{{ body }}</div>
        {% endif %}
      </div>
      {% if image is not empty %}
        <div class="text-image__image">{{ image }}</div>
      {% endif %}
    </div>
  </div>
</div>

